@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  font-family: "Noto Sans SC", "PingFang SC", system-ui, sans-serif;
  font-synthesis: none;
  color: #1b2430;
  background: #edf1f5;
}
* { box-sizing: border-box; }
html { min-width: 320px; background: #edf1f5; }
body { margin: 0; min-width: 320px; min-height: 100vh; background: radial-gradient(circle at 80% -10%, #d9e9ef 0, transparent 38rem), #edf1f5; }
button, input, textarea, select { font: inherit; }
button:disabled { cursor: not-allowed; opacity: .45; }
.app-shell { margin: 0 auto; }
.top-header { position: sticky; top: 0; z-index: 30; min-height: 74px; display: grid; grid-template-columns: 210px minmax(260px, 1fr) auto; align-items: center; gap: 20px; padding: 12px 24px; border-bottom: 1px solid rgba(50,68,86,.12); background: rgba(247,250,252,.9); backdrop-filter: blur(18px); }
.brand-block { display: flex; align-items: center; gap: 11px; }
.brand-mark { width: 42px; height: 42px; display: grid; place-items: center; border-radius: 11px; color: #f7fbff; background: linear-gradient(145deg, #124f61, #1e7a84); box-shadow: 0 10px 28px rgba(20,91,106,.2); font-size: 20px; font-weight: 900; }
.brand-block strong, .brand-block span { display: block; }
.brand-block strong { font-size: 17px; letter-spacing: .04em; }
.brand-block span, .eyebrow { color: #708090; font-size: 10px; font-weight: 800; letter-spacing: .14em; }
.practice-title h1 { margin: 0; font-size: clamp(17px, 2vw, 23px); font-weight: 820; letter-spacing: -.02em; }
.practice-title span { color: #738290; font-size: 11px; }
.header-actions { display: flex; align-items: center; gap: 7px; }
.save-state { min-width: 90px; color: #708090; font-size: 11px; text-align: right; }
.badge, .chapter-badge { display: inline-flex; align-items: center; padding: 4px 8px; border-radius: 999px; font-size: 10px; font-weight: 760; }
.connection { color: #176142; background: #d8f0e3; }
.connection.offline { color: #8a4d12; background: #f8e2bd; }
.progress-strip { display: grid; grid-template-columns: 150px minmax(180px, 1fr) repeat(3, 120px); align-items: center; gap: 20px; padding: 12px 24px; border-bottom: 1px solid rgba(50,68,86,.1); background: #f8fafb; }
.progress-copy { display: flex; justify-content: space-between; align-items: baseline; }
.progress-copy span, .progress-metric span { color: #71808e; font-size: 11px; }
.progress-copy strong { color: #164f60; font-size: 15px; }
.progress-metric { display: flex; justify-content: space-between; align-items: baseline; padding-left: 16px; border-left: 1px solid #d9e0e5; }
.progress-metric strong { font-size: 18px; }
.mobile-tabs { display: none; }
.workspace { display: grid; grid-template-columns: 300px minmax(460px, 1fr) 350px; gap: 14px; padding: 16px; align-items: start; }
.card { padding: 18px; border: 1px solid rgba(49,70,89,.13); border-radius: 15px; background: rgba(255,255,255,.9); box-shadow: 0 10px 34px rgba(35,56,74,.055); }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-bottom: 16px; }
h2 { margin: 3px 0 0; font-size: 19px; font-weight: 800; letter-spacing: -.02em; }
.label { display: grid; gap: 6px; margin-bottom: 12px; }
.label > span { color: #5f6e7c; font-size: 12px; font-weight: 680; }
.input, .textarea, .select { width: 100%; padding: 9px 11px; border: 1px solid #ccd6de; border-radius: 9px; color: #1d2936; background: #fff; outline: none; transition: border-color .15s, box-shadow .15s; }
.textarea { resize: vertical; line-height: 1.65; }
.input:focus, .textarea:focus, .select:focus { border-color: #278695; box-shadow: 0 0 0 3px rgba(39,134,149,.12); }
.inline-actions { display: flex; align-items: center; gap: 9px; }
.inline-actions > span { margin-left: auto; color: #7c8a97; font-size: 11px; }
.group-column { position: sticky; top: 92px; max-height: calc(100vh - 110px); overflow-y: auto; }
.group-list { display: grid; gap: 7px; margin: 15px 0 10px; }
.group-item { width: 100%; display: grid; grid-template-columns: 34px minmax(0, 1fr); gap: 8px; align-items: start; padding: 11px; border: 1px solid transparent; border-radius: 10px; color: inherit; background: #f5f7f9; text-align: left; cursor: pointer; transition: .15s; }
.group-item:hover { border-color: #bcd0d8; }
.group-item.active { border-color: #278695; background: #e7f3f5; box-shadow: inset 3px 0 #278695; }
.group-index { color: #8a9aa6; font: 700 11px/1.7 ui-monospace, monospace; }
.group-copy { min-width: 0; }
.group-copy strong, .group-copy small { display: block; }
.group-copy strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 13px; }
.group-copy small { margin-top: 5px; color: #758694; font-size: 10px; line-height: 1.5; }
.sidebar-actions { display: flex; gap: 7px; }
.shortcut-note { display: grid; gap: 5px; margin-top: 16px; padding: 12px; border-radius: 10px; color: #71808e; background: #f0f4f6; font-size: 10px; }
.shortcut-note strong { color: #516170; }
.annotation-column, .review-column { display: grid; gap: 14px; }
.annotation-card { min-height: 360px; }
.chapter-badge { color: #17606b; background: #dceff2; }
.token-board { padding: 15px; margin: 4px 0 16px; border: 1px dashed #b9cbd3; border-radius: 11px; background: #f6fafb; }
.token-label { margin-bottom: 10px; color: #7c8d99; font-size: 10px; letter-spacing: .08em; }
.token-list { display: flex; flex-wrap: wrap; gap: 3px; }
.text-token { position: relative; min-width: 31px; min-height: 38px; padding: 5px; border: 0; border-radius: 7px; color: #344452; background: transparent; font-size: 20px; cursor: pointer; }
.text-token:hover { background: #e8eef1; }
.text-token.stressed { color: #a33d2f; background: #f9ddd6; font-weight: 850; }
.text-token.stressed::after { content: ''; position: absolute; left: 8px; right: 8px; bottom: 2px; height: 3px; border-radius: 4px; background: #d95c49; }
.annotation-grid, .score-grid, .progress-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.span-2 { grid-column: 1 / -1; }
.segmented { display: flex; padding: 3px; border-radius: 9px; background: #e9eef1; }
.segmented button { flex: 1; padding: 6px 4px; border: 0; border-radius: 7px; color: #60707d; background: transparent; font-size: 11px; cursor: pointer; }
.segmented button.active { color: #fff; background: #287c88; box-shadow: 0 2px 8px rgba(32,105,116,.2); }
.range { width: 100%; accent-color: #287c88; }
.prosody-preview { display: grid; grid-template-columns: 90px 1fr; gap: 12px; margin-top: 15px; padding: 14px; border-radius: 11px; color: #eaf4f6; background: #173f49; }
.prosody-preview strong { font-size: 12px; }
.prosody-preview .eyebrow { color: #91b8bf; }
.prosody-preview p { margin: 0; font-size: 18px; line-height: 1.7; }
.stress-line { display: block; color: #ffae93; font-size: 10px; letter-spacing: .25em; }
.pause-mark { padding: 0 7px; color: #f7c987; font-size: 11px; }
.intonation-mark { display: block; color: #9bd2d5; font-size: 12px; }
.recorder-card { position: sticky; bottom: 16px; }
.record-dot { color: #627381; font-size: 10px; font-weight: 800; letter-spacing: .1em; }
.record-dot.recording { color: #c23f36; animation: pulse 1s infinite; }
.record-console { display: grid; justify-items: center; padding: 8px 0 3px; }
.record-time { font: 700 34px/1.1 ui-monospace, monospace; }
.level-bars { width: min(320px, 100%); height: 68px; display: flex; align-items: center; justify-content: center; gap: 3px; margin: 10px 0; }
.level-bars span { width: 5px; max-height: 100%; border-radius: 5px; background: linear-gradient(#2b8b97, #9acbd0); transition: height .1s; }
.record-button { min-width: 220px; padding: 12px 20px; }
.record-console p { color: #7b8a97; font-size: 11px; text-align: center; }
.review-column { position: sticky; top: 92px; max-height: calc(100vh - 110px); overflow-y: auto; }
.attempt-list { display: grid; gap: 7px; }
.attempt-item { width: 100%; display: grid; grid-template-columns: 30px 1fr auto; align-items: center; gap: 8px; padding: 10px; border: 1px solid #d9e0e5; border-radius: 9px; color: inherit; background: #fff; text-align: left; cursor: pointer; }
.attempt-item.active { border-color: #278695; background: #eaf5f6; }
.attempt-number { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; color: #fff; background: #567885; font-size: 11px; font-weight: 800; }
.attempt-item strong, .attempt-item small { display: block; }
.attempt-item strong { font-size: 12px; }
.attempt-item small { margin-top: 3px; color: #81909c; font-size: 10px; }
.attempt-score { color: #17606b; font-weight: 800; }
.playback-card { order: 2; }
.issues-card { order: 3; }
.feedback-card { order: 4; }
.playback-card.recommended, .issues-card.recommended, .feedback-card.recommended { outline: 2px solid rgba(39,134,149,.2); }
.playback-timeline { position: relative; height: 24px; margin: 4px 0 12px; border-radius: 7px; background: repeating-linear-gradient(90deg, #dce5ea 0 2px, transparent 2px 5px); overflow: hidden; }
.range-fill { position: absolute; top: 4px; bottom: 4px; background: rgba(39,134,149,.24); border-left: 2px solid #278695; border-right: 2px solid #278695; }
.playhead { position: absolute; z-index: 2; top: 0; bottom: 0; width: 2px; background: #d65f45; transition: left .08s linear; }
.range-controls { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }
.range-controls label, .score-grid label { display: grid; gap: 4px; }
.range-controls span, .score-grid span { color: #667684; font-size: 10px; }
.score-grid { margin-bottom: 12px; }
.issue-form { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.issue-list, .feedback-list { display: grid; gap: 7px; margin: 14px 0; }
.issue-item { display: grid; grid-template-columns: auto 1fr auto; gap: 6px 8px; align-items: center; padding: 9px; border: 1px solid #e0e6ea; border-radius: 9px; background: #f9fbfc; }
.issue-item p { grid-column: 1 / -1; margin: 0; color: #6f7f8c; font-size: 11px; }
.feedback-item { padding: 10px; border-left: 3px solid #2b8693; border-radius: 0 9px 9px 0; background: #eff6f7; }
.feedback-item strong { color: #225f69; font-size: 12px; }
.feedback-item p { margin: 5px 0; font-size: 12px; line-height: 1.55; }
.feedback-item small, .empty-copy { color: #84939e; font-size: 10px; }
.progress-dashboard { grid-column: 1 / -1; }
.progress-grid { grid-template-columns: repeat(4, 1fr); }
.progress-grid > div { display: grid; padding: 14px; border-radius: 11px; background: #f2f6f8; text-align: center; }
.progress-grid strong { color: #17606b; font-size: 26px; }
.progress-grid span { color: #71808e; font-size: 11px; }
.category-list { display: grid; gap: 10px; margin: 18px 0; }
.category-list > div { display: grid; grid-template-columns: 90px 1fr 30px; align-items: center; gap: 10px; font-size: 12px; }
.mini-bar { height: 9px; overflow: hidden; border-radius: 9px; background: #dfe7eb; }
.mini-bar i { display: block; height: 100%; border-radius: 9px; background: linear-gradient(90deg, #2b8693, #73b5b8); }
.loading-overlay { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; background: rgba(237,241,245,.82); backdrop-filter: blur(8px); }
.loading-bar { padding: 12px 18px; border-radius: 10px; color: #fff; background: #17606b; }
@keyframes pulse { 50% { opacity: .35; } }
@media (max-width: 1180px) {
  .top-header { grid-template-columns: 180px 1fr; }
  .header-actions { grid-column: 1 / -1; justify-content: flex-end; }
  .workspace { grid-template-columns: 270px minmax(440px, 1fr); }
  .review-column { position: static; grid-column: 1 / -1; max-height: none; grid-template-columns: repeat(2, 1fr); }
  .attempts-card, .feedback-card { align-self: start; }
}
@media (max-width: 820px) {
  .top-header { position: static; display: flex; flex-wrap: wrap; padding: 12px; gap: 10px; }
  .brand-block { width: auto; }
  .practice-title { flex: 1; min-width: 0; }
  .practice-title h1 { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .header-actions { width: 100%; overflow-x: auto; justify-content: flex-start; }
  .save-state { margin-left: auto; }
  .progress-strip { grid-template-columns: 1fr 1fr; padding: 12px; }
  .progress-strip > :nth-child(2) { grid-column: 1 / -1; grid-row: 1; }
  .progress-metric { border-left: 0; padding-left: 0; }
  .mobile-tabs { position: sticky; top: 0; z-index: 20; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 7px 10px; border-bottom: 1px solid #d6dfe4; background: rgba(247,250,252,.95); }
  .mobile-tabs button { padding: 8px; border: 0; border-radius: 8px; color: #657582; background: transparent; font-size: 12px; font-weight: 700; }
  .mobile-tabs button.active { color: #fff; background: #277b87; }
  .workspace { display: block; padding: 10px; }
  .mobile-hidden { display: none !important; }
  .group-column, .review-column { position: static; max-height: none; margin-bottom: 12px; }
  .review-column > .card { margin-bottom: 12px; }
  .annotation-column { margin-bottom: 12px; }
  .annotation-column .mobile-hidden { display: none !important; }
  .recorder-card { position: static; }
  .progress-dashboard { display: block; }
  .progress-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 520px) {
  .brand-block span { display: none; }
  .brand-mark { width: 36px; height: 36px; }
  .practice-title span { display: none; }
  .card { padding: 14px; border-radius: 12px; }
  .annotation-grid, .score-grid, .range-controls, .issue-form { grid-template-columns: 1fr; }
  .span-2 { grid-column: auto; }
  .prosody-preview { grid-template-columns: 1fr; }
  .text-token { min-width: 28px; font-size: 18px; }
}
